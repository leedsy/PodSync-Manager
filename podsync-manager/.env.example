# Generated automatically by setup.sh on a fresh install.
# Existing installations keep their current .env unchanged.

ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-long-random-string

PODSYNC_CONTAINER=podsync
PODSYNC_CONFIG_PATH=/podsync/config.toml
PODSYNC_DATA_DIR=/podsync/data
MANAGER_DATA_DIR=/manager-data
MANAGER_ENV_PATH=/manager-host/.env

# These are intentionally blank on first install and are completed in the web GUI.
RSS_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HOST_LAN_IP=
